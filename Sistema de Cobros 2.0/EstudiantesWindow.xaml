<Window x:Class="Sistema_de_Cobros_2._0.EstudiantesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Estudiantes e Inscripciones" Height="650" Width="1020"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- CONTENIDO PRINCIPAL CON DOS PESTAÑAS -->
        <Grid Margin="15">
            <TabControl Background="White" BorderBrush="#E5E7EB">

                <!-- PESTAÑA 1: GESTIÓN DE INSCRIPCIONES, BAJAS Y TRASLADOS -->
                <TabItem Header="Inscripciones y Desertores" Padding="15,8" FontWeight="SemiBold">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- FILTROS -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Buscar Alumno o Código:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555"/>
                                <TextBox x:Name="txtBuscar" Width="280" Style="{StaticResource ModernTextBox}" 
                                         TextChanged="TxtBuscar_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555"/>
                                <ComboBox x:Name="cmbFiltroEstado" Width="130" Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="CmbFiltroEstado_SelectionChanged">
                                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                                    <ComboBoxItem Content="Activa"/>
                                    <ComboBoxItem Content="Suspendida"/>
                                    <ComboBoxItem Content="Cancelada"/>
                                    <ComboBoxItem Content="Finalizada"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- TABLA DE ALUMNOS -->
                        <DataGrid Grid.Row="1" x:Name="dgInscripciones" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" Background="Transparent" BorderThickness="1" 
                                  BorderBrush="#E5E7EB" RowBackground="White" AlternatingRowBackground="#F9FAFB"
                                  SelectionChanged="DgInscripciones_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="90"/>
                                <DataGridTextColumn Header="Estudiante" Binding="{Binding NombreCompleto}" Width="180"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110"/>
                                <DataGridTextColumn Header="Grupo / Cohorte" Binding="{Binding GrupoCodigo}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Curso y Horario" Binding="{Binding Display}" Width="240"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Nota / Historial de Traslados" Binding="{Binding Observaciones}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- PANEL DE ACCIONES INFERIOR -->
                        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                                CornerRadius="6" Padding="15" Margin="0,15,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="txtAlumnoSeleccionado" Grid.Row="0" 
                                           Text="Seleccione un estudiante de la tabla superior para gestionar su estado o cambiarlo de grupo." 
                                           FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" x:Name="panelAcciones" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Campo de Motivo (Opcional) -->
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                        <TextBlock Text="Motivo (Opcional para suspensiones o bajas):" 
                                                   FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtMotivo" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Botones de Acción -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <!-- BOTÓN DE TRASLADO DE GRUPO -->
                                        <Button Content="Cambiar de Horario" Style="{StaticResource BotonRedondeado}"
                                                Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="12,8"
                                                Margin="0,0,8,0" Click="BtnAbrirModalCambio_Click"/>

                                        <Button Content="Suspender (Temporal)" Style="{StaticResource BotonRedondeado}"
                                                Background="#FF9800" Foreground="White" FontWeight="Bold" Padding="12,8"
                                                Margin="0,0,8,0" Click="BtnSuspender_Click"/>

                                        <Button Content="Desertor (Cancelar)" Style="{StaticResource BotonRedondeado}"
                                                Background="#F44336" Foreground="White" FontWeight="Bold" Padding="12,8"
                                                Margin="0,0,8,0" Click="BtnCancelar_Click"/>

                                        <Button Content="Reactivar Alumno" Style="{StaticResource BotonRedondeado}"
                                                Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="12,8"
                                                Click="BtnReactivar_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- PESTAÑA 2: REGISTRAR NUEVO ALUMNO (SELECCIÓN EN CASCADA) -->
                <TabItem Header="Registrar Nuevo Alumno" Padding="15,8" FontWeight="SemiBold">
                    <Border Padding="30" MaxWidth="520" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Registrar e Inscribir Alumno" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1976D2"/>

                            <TextBlock Text="Cédula" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                            <TextBox x:Name="txtCedula" Style="{StaticResource ModernTextBox}" Margin="0,2,0,10"/>

                            <TextBlock Text="Nombre Completo" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource ModernTextBox}" Margin="0,2,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Teléfono" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBox x:Name="txtTelefono" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Correo Electrónico" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- SELECCIÓN EN CASCADA PASO 1: CURSO -->
                            <TextBlock Text="1. Seleccione la Carrera o Curso" FontSize="12" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,10,0,4"/>
                            <ComboBox x:Name="cmbNuevoCurso" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Nombre" SelectedValuePath="Codigo" SelectionChanged="CmbNuevoCurso_SelectionChanged" Margin="0,0,0,10"/>

                            <!-- SELECCIÓN EN CASCADA PASO 2: HORARIO DEL CURSO SELECCIONADO -->
                            <TextBlock Text="2. Seleccione el Horario / Cohorte" FontSize="12" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbNuevoGrupo" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Display" SelectedValuePath="Id" IsEnabled="False" SelectionChanged="CmbNuevoGrupo_SelectionChanged" Margin="0,0,0,10"/>

                            <!-- FICHA INFORMATIVA DINÁMICA -->
                            <Border x:Name="pnlInfoCurso" Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,20" Visibility="Collapsed">
                                <TextBlock x:Name="txtInfoCurso" Text="Duración: ... | Precio Clase: ... | Inicio: ..." FontSize="12" Foreground="#0369A1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="Finalizar Inscripción" Style="{StaticResource BotonRedondeado}"
                                    Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="15,10"
                                    Click="BtnGuardar_Click"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- MODAL OVERLAY: TRASLADO DE GRUPO (DENTRO DEL MISMO CURSO) -->
        <Grid x:Name="modalCambioGrupo" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="10" Padding="25" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.25" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Traslado de Horario / Grupo" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,5"/>
                    <TextBlock Text="Permite mover al estudiante a otro turno del mismo curso manteniendo intactos todos sus pagos." Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="txtModalAlumno" Text="Alumno: ..." FontWeight="Bold" FontSize="13" Foreground="#333"/>
                            <TextBlock x:Name="txtModalCurso" Text="Curso: ..." FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="txtModalGrupoActual" Text="Grupo Actual: ..." FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Seleccione el nuevo grupo o turno al que se traslada:" FontSize="11" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbModalNuevosGrupos" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Display" SelectedValuePath="Id" Margin="0,0,0,12"/>

                    <TextBlock Text="Motivo del traslado (Opcional - Ej: Cambio de horario laboral):" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtModalMotivo" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Background="Transparent" Foreground="#666" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="BtnCerrarModalCambio_Click"/>
                        <Button Content="Procesar Traslado" Style="{StaticResource BotonRedondeado}" Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="10,0,0,0" Click="BtnConfirmarCambioGrupo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>