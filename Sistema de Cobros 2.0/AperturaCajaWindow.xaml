<Window x:Class="Sistema_de_Cobros_2._0.AperturaCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apertura de Caja" Height="280" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <StackPanel>
                <TextBlock Text="Apertura de Turno" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock Text="Indique el efectivo en gaveta con el que inicia el turno:" Foreground="#666" FontSize="11" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Efectivo en Bolívares (Bs)" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSaldoBs" Text="0,00" Padding="8" FontSize="14" BorderBrush="#ccc" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Efectivo en Dólares ($)" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSaldoUsd" Text="0,00" Padding="8" FontSize="14" BorderBrush="#ccc" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="* Puede dejar en 0,00 si arranca sin efectivo de esa moneda." FontSize="10" Foreground="#888" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="15,8" Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                    <Button IsDefault="True" Content="Abrir Caja" Padding="18,8" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnAbrir_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>