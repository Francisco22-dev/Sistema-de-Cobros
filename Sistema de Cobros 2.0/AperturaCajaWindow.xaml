<Window x:Class="Sistema_de_Cobros_2._0.AperturaCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apertura de Caja" Height="260" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <StackPanel>
                <TextBlock Text="Apertura de Turno" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock Text="Indique el fondo físico existente en caja para iniciar el día:" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Fondo Inicial en Gaveta" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSaldoInicial" Text="0,00" Padding="8" FontSize="14" BorderBrush="#ccc" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Moneda" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbMonedaInicial" Padding="8" FontSize="13" BorderBrush="#ccc">
                            <ComboBoxItem Content="$" IsSelected="True"/>
                            <ComboBoxItem Content="BS"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="15,8" Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                    <Button IsDefault="True" Content="Abrir Caja" Padding="18,8" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnAbrir_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>