<Window x:Class="Sistema_de_Cobros_2._0.AperturaCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apertura de Caja" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <StackPanel>
                <TextBlock Text="Apertura de Turno" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                <TextBlock Text="¿Desea abrir un nuevo turno de caja en este momento para comenzar a registrar cobros?" 
                           TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="15,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                    <Button IsDefault="True" Content="Abrir Caja" Padding="15,8" Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnAbrir_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>