<Window x:Class="Sistema_de_Cobros_2._0.AperturaCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apertura de Caja" Height="270" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="Apertura de Caja" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
            <TextBlock Text="Indique el monto de dinero físico (fondo o base) con el que inicia la caja hoy:" 
                       TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,15"/>

            <TextBox x:Name="txtSaldoInicial" Padding="10" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Text="0.00" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="15,8" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button Content="Abrir Caja" Padding="15,8" Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnAbrir_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </Grid>
</Window>