<Window x:Class="Sistema_de_Cobros_2._0.LicenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Licencia" Height="350" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="Renovación de Licencia" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,10"/>

            <TextBlock Text="Clave Maestra de Seguridad" FontSize="12" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtClave" Padding="8" BorderBrush="#ccc" BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Nueva fecha de vencimiento" FontSize="12" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpFecha" Margin="0,0,0,25"/>

            <Button IsDefault="True" Content="Renovar Licencia" Background="#D32F2F" Foreground="White" Padding="15,10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRenovar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>