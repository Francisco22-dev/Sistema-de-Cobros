<Window x:Class="Sistema_de_Cobros_2._0.MantenimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento del Sistema" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="Mantenimiento y Respaldo" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Optimizar la base de datos mejorará la velocidad de respuesta del sistema. Realizar respaldos protegerá la información contra pérdidas." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,20"/>

            <Button Content="Optimizar Sistema" Background="#4CAF50" Foreground="White" Padding="15,12" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Margin="0,0,0,15" Click="BtnOptimizar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Generar Respaldo (Backup)" Background="#2196F3" Foreground="White" Padding="15,12" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="BtnRespaldar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>