<Window x:Class="Sistema_de_Cobros_2._0.ConfigurarTasaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasa del Día" Height="270" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="Configurar Tasa del Día" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Indique el valor del dólar hoy:" TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock Text="Tasa del Dólar BCV ($)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtBCV" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,20"/>

            <!-- EUR y USDT Comentados por si se necesitan a futuro -->
            <!--<TextBlock Text="Tasa EUR (Euro)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtEUR" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,10"/>
            <TextBlock Text="Tasa USDT (Binance)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtUSDT" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,20"/>-->

            <Button IsDefault="True" Content="Guardar Tasa" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="BtnGuardar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>