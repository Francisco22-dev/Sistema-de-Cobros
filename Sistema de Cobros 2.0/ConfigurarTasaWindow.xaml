<Window x:Class="Sistema_de_Cobros_2._0.ConfigurarTasaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasas del Día" Height="380" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="Configurar Tasas" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Indique el valor en Bolívares (BS) para cada divisa hoy:" TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock Text="Tasa USD (Dólar)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtUSD" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,10"/>

            <TextBlock Text="Tasa EUR (Euro)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtEUR" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,10"/>

            <TextBlock Text="Tasa USDT (Tether)" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="txtUSDT" Padding="8" FontSize="16" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,20"/>

            <Button Content="Guardar Tasas" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="BtnGuardar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>