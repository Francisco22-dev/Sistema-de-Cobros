<Window x:Class="Sistema_de_Cobros_2._0.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cierre y Arqueo de Caja" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Arqueo de Caja" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
            <TextBlock Grid.Row="1" Text="Verifique que estos montos coincidan con el dinero físico y sus cuentas bancarias antes de cerrar." 
                       TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,15"/>

            <DataGrid Grid.Row="2" x:Name="dgArqueo" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E0E0E0" 
                      RowBackground="White" AlternatingRowBackground="#F9FAFB" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Método de Pago" Binding="{Binding Metodo}" Width="*"/>
                    <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="80"/>
                    <DataGridTextColumn Header="Monto Recaudado" Binding="{Binding Total, StringFormat=N2}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="15,10" Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button Content="TODO CUADRA - CERRAR CAJA" Padding="15,10" Background="#F44336" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnConfirmarCierre_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>