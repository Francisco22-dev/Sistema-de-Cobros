<Window x:Class="Sistema_de_Cobros_2._0.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cierre y Arqueo de Caja" Height="550" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Arqueo de Caja" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="Verifique los montos según la distribución física y bancaria." Foreground="#666" FontSize="12"/>
                </StackPanel>

                <!-- Desglose por Método -->
                <DataGrid Grid.Row="1" x:Name="dgArqueo" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E0E0E0" 
                          RowBackground="White" AlternatingRowBackground="#F9FAFB" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Método de Pago" Binding="{Binding Metodo}" Width="*"/>
                        <DataGridTextColumn Header="Mon." Binding="{Binding Moneda}" Width="50"/>
                        <DataGridTextColumn Header="Monto Recaudado" Binding="{Binding Total, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Totales Estilo Libreta -->
                <Border Grid.Row="2" Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTALES BOLÍVARES (BS)" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtFisicoBs" Text="Físico (Efectivo): 0.00 BS"/>
                            <TextBlock x:Name="txtBancoBs" Text="Banco (PM/Transf): 0.00 BS"/>
                            <TextBlock x:Name="txtTotalBs" Text="TOTAL BS: 0.00 BS" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTALES DIVISAS ($)" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtFisicoUsd" Text="Físico (Billetes): 0.00 $"/>
                            <TextBlock x:Name="txtBancoUsd" Text="Banco (Zelle): 0.00 $"/>
                            <TextBlock x:Name="txtTotalUsd" Text="TOTAL $: 0.00 $" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="15,10" Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
                    <Button Content="CERRAR CAJA Y RESPALDAR" Padding="15,10" Background="#F44336" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnConfirmarCierre_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>