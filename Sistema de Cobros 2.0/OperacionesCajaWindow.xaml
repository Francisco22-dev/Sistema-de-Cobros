<Window x:Class="Sistema_de_Cobros_2._0.OperacionesCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operaciones Especiales de Caja" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <TabControl Background="White" BorderBrush="#E0E0E0">

            <!-- PESTAÑA 1: VUELTOS Y REEMBOLSOS CON SELECTOR DE RECIBO -->
            <TabItem Header="Vueltos / Reembolsos" Padding="15,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <TextBlock Text="Reembolso de Recibo / Vuelto" FontSize="18" FontWeight="Bold" Foreground="#F44336" Margin="0,0,0,4"/>
                        <TextBlock Text="Permite anular un recibo vigente devolviendo el dinero o registrar un vuelto ordinario." Foreground="#666" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

                        <!-- BUSCADOR DE RECIBO EN CONCRETO -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Buscar Recibo para Anulación y Devolución:" FontSize="11" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBuscarRecibo" Style="{StaticResource ModernTextBox}" KeyDown="TxtBuscarRecibo_KeyDown"/>
                                    <Button Grid.Column="1" Content="Buscar Recibo" Style="{StaticResource BotonRedondeado}" 
                                            Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="6,0,0,0" 
                                            Click="BtnBuscarRecibo_Click"/>
                                </Grid>

                                <!-- TARJETA DE RECIBO ENCONTRADO -->
                                <Border x:Name="bdrReciboEncontrado" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="txtInfoReciboCabecera" Grid.Row="0" Text="Recibo: ... • Alumno: ..." FontWeight="Bold" Foreground="#1E40AF" FontSize="12"/>
                                        <TextBlock x:Name="txtInfoReciboCurso" Grid.Row="1" Text="Curso / Horario: ..." FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="txtInfoReciboMonto" Grid.Row="2" Text="Total a Devolver: 0,00 $" FontWeight="Bold" Foreground="#D97706" FontSize="13" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Método de Salida (Desde dónde sale el dinero de la gaveta)" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <ComboBox x:Name="cmbMetodoVuelto" Padding="8" FontSize="13" BorderBrush="#ccc" Margin="0,2,0,10">
                            <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                            <ComboBoxItem Content="Pago Móvil"/>
                            <ComboBoxItem Content="Transferencia"/>
                            <ComboBoxItem Content="Divisas (Físico)"/>
                            <ComboBoxItem Content="Zelle"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Monto a devolver" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                                <TextBox x:Name="txtMontoVuelto" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Moneda" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                                <ComboBox x:Name="cmbMonedaVuelto" Padding="8" FontSize="13" BorderBrush="#ccc" Margin="0,2,0,0">
                                    <ComboBoxItem Content="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="$"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motivo del Reembolso / Devolución (Obligatorio)" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBox x:Name="txtMotivoVuelto" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Style="{StaticResource ModernTextBox}" Margin="0,2,0,15"/>

                        <Button Content="Procesar Reembolso / Vuelto" Style="{StaticResource BotonRedondeado}" 
                                Background="#F44336" Foreground="White" FontWeight="Bold" Padding="15,10" 
                                Click="BtnProcesarVuelto_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PESTAÑA 2: CAMBIO DE DIVISAS -->
            <TabItem Header="Cambio de Divisas" Padding="15,8">
                <StackPanel Margin="5">
                    <TextBlock Text="Cambio de Moneda" FontSize="18" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,8"/>
                    <TextBlock Text="Ejemplo: Entran Dólares en Físico y sale Pago Móvil." Foreground="#666" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

                    <!-- INGRESO -->
                    <Border BorderBrush="#4CAF50" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="RECIBIMOS (Ingreso a Caja)" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbMetodoEntra" Padding="6" FontSize="13" Margin="0,0,0,6">
                                <ComboBoxItem Content="Efectivo"/>
                                <ComboBoxItem Content="Pago Móvil"/>
                                <ComboBoxItem Content="Transferencia"/>
                                <ComboBoxItem Content="Divisas (Físico)" IsSelected="True"/>
                                <ComboBoxItem Content="Zelle"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMontoEntra" TextChanged="Input_Changed" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbMonedaEntra" SelectionChanged="Input_Changed" Grid.Column="1" Padding="6" FontSize="13">
                                    <ComboBoxItem Content="$" IsSelected="True"/>
                                    <ComboBoxItem Content="BS"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- EGRESO -->
                    <Border BorderBrush="#F44336" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="ENTREGAMOS (Salida de Caja)" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbMetodoSale" Padding="6" FontSize="13" Margin="0,0,0,6">
                                <ComboBoxItem Content="Efectivo"/>
                                <ComboBoxItem Content="Pago Móvil" IsSelected="True"/>
                                <ComboBoxItem Content="Transferencia"/>
                                <ComboBoxItem Content="Divisas (Físico)"/>
                                <ComboBoxItem Content="Zelle"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMontoSale" IsReadOnly="True" Background="#E5E7EB" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbMonedaSale" SelectionChanged="Input_Changed" Grid.Column="1" Padding="6" FontSize="13">
                                    <ComboBoxItem Content="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="$"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Detalle / Motivo del Cambio" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox x:Name="txtMotivoCambio" Style="{StaticResource ModernTextBox}" Margin="0,2,0,12"/>

                    <Button Content="Procesar Cambio" Style="{StaticResource BotonRedondeado}" 
                            Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="15,10" 
                            Click="BtnProcesarCambio_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>