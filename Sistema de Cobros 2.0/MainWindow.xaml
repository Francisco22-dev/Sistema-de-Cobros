<Window x:Class="Sistema_de_Cobros_2._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Cobros 2.0" Height="700" Width="1100"
        WindowState="Maximized" Background="#F0F2F5">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2196F3"/>
        <SolidColorBrush x:Key="Success" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Danger" Color="#F44336"/>
        <SolidColorBrush x:Key="TextDark" Color="#333333"/>

        <!-- ESTILO PARA BOTONES REDONDEADOS EN WPF -->
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sistema de Cobros" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                <Border Background="#E3F2FD" CornerRadius="15" Padding="15,5" Margin="20,0,0,0">
                    <TextBlock x:Name="txtTasaDia" Text="Tasa BCV: Cargando..." Foreground="#1976D2" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnMorosos" Content="Morosidad" Style="{StaticResource BotonRedondeado}" Background="#FFEBEE" Foreground="#D32F2F" BorderThickness="0" Padding="15,8" Click="BtnMorosos_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnCalendario" Content="Calendario" Style="{StaticResource BotonRedondeado}" Background="White" Foreground="{StaticResource TextDark}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15,8" Click="BtnCalendario_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnAbrirCaja" Content="Abrir Caja" Style="{StaticResource BotonRedondeado}" Background="{StaticResource Success}" Foreground="White" Padding="15,8" Click="BtnAbrirCaja_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnCerrarCaja" Content="Cerrar Caja" Style="{StaticResource BotonRedondeado}" Background="{StaticResource Danger}" Foreground="White" Padding="15,8" Click="BtnCerrarCaja_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="btnFlujoCaja" Content="Flujo de Caja (Egresos)" Style="{StaticResource BotonRedondeado}" Background="#FF9800" Foreground="White" BorderThickness="0" Padding="15,8" Click="BtnFlujoCaja_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnConfigurarTasa" Content="Tasa BCV" Style="{StaticResource BotonRedondeado}" Background="White" Foreground="{StaticResource TextDark}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15,8" Click="BtnConfigurarTasa_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="btnGestionUsuarios" Content="Usuarios" Style="{StaticResource BotonRedondeado}" Background="White" Foreground="{StaticResource TextDark}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15,8" Click="BtnGestionUsuarios_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="btnCursos" Content="Cursos" Style="{StaticResource BotonRedondeado}" Background="White" Foreground="{StaticResource TextDark}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15,8" Click="BtnCursos_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="btnAuditoria" Content="Auditoría" Style="{StaticResource BotonRedondeado}" Background="White" Foreground="{StaticResource TextDark}" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15,8" Click="BtnAuditoria_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: FORMULARIO -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CAJA ESTADO -->
                        <Border x:Name="bdrEstadoCaja" Background="{StaticResource Success}" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Saldo Disponible (Neto)" Foreground="White" FontSize="12" Opacity="0.9" VerticalAlignment="Center"/>

                                    <!-- Selector de moneda para visualizar el Saldo -->
                                    <ComboBox x:Name="cmbMonedaSaldo" Grid.Column="1" FontSize="11" Padding="5,2" SelectionChanged="CmbMonedaSaldo_SelectionChanged">
                                        <ComboBoxItem Content="BS" IsSelected="True"/>
                                        <ComboBoxItem Content="BCV (Dólares)"/>
                                        <ComboBoxItem Content="EUR"/>
                                        <ComboBoxItem Content="USDT"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="txtTotalHoy" Text="Bs. 0.00" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Nuevo Cobro" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                        <!-- DATOS BÁSICOS (BUSCADOR DE ESTUDIANTES) -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Buscar Estudiante (Cédula o Nombre)" FontSize="12" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                                <!-- Este ComboBox autocompleta mientras escribes -->
                                <ComboBox x:Name="cmbEstudiante" Style="{StaticResource ModernComboBox}" 
                                          IsEditable="True" IsTextSearchEnabled="True" 
                                          TextSearch.TextPath="Display" DisplayMemberPath="Display"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <Button x:Name="btnNuevoEstudiante" Content="Nuevo" Style="{StaticResource BotonRedondeado}" 
                                        Background="#E3F2FD" Foreground="#1976D2" FontWeight="Bold" Padding="15,9" 
                                        Click="BtnNuevoEstudiante_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Concepto de Pago" FontSize="12" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbConcepto" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Semana (Clase)" Tag="3" IsSelected="True"/>
                                    <ComboBoxItem Content="Mensualidad" Tag="2"/>
                                    <ComboBoxItem Content="Inscripción" Tag="1"/>
                                    <ComboBoxItem Content="Material Didáctico" Tag="4"/>
                                    <ComboBoxItem Content="Certificación" Tag="5"/>
                                    <ComboBoxItem Content="Otro" Tag="6"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Moneda Base" FontSize="12" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbMonedaRecibo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="BCV"/>
                                    <ComboBoxItem Content="EUR"/>
                                    <ComboBoxItem Content="USDT"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                        <!-- PAGOS MIXTOS (DETALLES) -->
                        <TextBlock Text="Añadir Métodos de Pago" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMNA 0: MÉTODO -->
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Método" FontSize="11" Foreground="#666"/>
                                <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ModernComboBox}" Margin="0,2,0,0">
                                    <ComboBoxItem Content="Efectivo" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="Transferencia" Tag="2"/>
                                    <ComboBoxItem Content="Zelle" Tag="3"/>
                                    <ComboBoxItem Content="Pago Móvil" Tag="5"/>
                                    <ComboBoxItem Content="Divisas (Físico)" Tag="8"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- COLUMNA 1: MONEDA -->
                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="Moneda" FontSize="11" Foreground="#666"/>
                                <ComboBox x:Name="cmbMonedaDetalle" Style="{StaticResource ModernComboBox}" Margin="0,2,0,0">
                                    <ComboBoxItem Content="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="BCV"/>
                                    <ComboBoxItem Content="EUR"/>
                                    <ComboBoxItem Content="USDT"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- COLUMNA 2: MONTO -->
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Monto" FontSize="11" Foreground="#666"/>
                                <TextBox x:Name="txtMontoDetalle" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Referencia (opcional)" FontSize="11" Foreground="#666"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtReferenciaDetalle" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,2,10,0"/>
                                <Button x:Name="btnAgregarDetalle" Grid.Column="1" Style="{StaticResource BotonRedondeado}" Content="+ Añadir" Background="#E3F2FD" Foreground="#1976D2" FontWeight="Bold" Padding="15,0" Click="BtnAgregarDetalle_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- LISTA DE DETALLES AÑADIDOS -->
                        <DataGrid x:Name="dgDetalles" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" Background="Transparent" BorderThickness="0" RowBackground="#F9FAFB" Margin="0,0,0,15" MinHeight="50">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding MetodoNombre}" Width="*"/>
                                <DataGridTextColumn Binding="{Binding MontoStr}" Width="80"/>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Background="Transparent" Foreground="{StaticResource Danger}" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnEliminarDetalle_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TOTAL Y REGISTRAR -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                            <TextBlock Text="Total a Cobrar:" FontSize="14" FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="txtSumaTotal" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        </StackPanel>

                        <Button x:Name="btnRegistrar" Content="Procesar Factura" Style="{StaticResource BotonRedondeado}" Background="{StaticResource Primary}" Foreground="White" FontWeight="Bold" Padding="15,12" Click="BtnRegistrar_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PANEL DERECHO: HISTORIAL -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ENCABEZADO Y BUSCADOR -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Últimos Pagos Registrados" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtBuscarPago" Width="200" Style="{StaticResource ModernTextBox}" TextChanged="TxtBuscarPago_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgHistorial" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9FAFB" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <!-- Estilos... -->
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Recibo" Binding="{Binding NumeroRecibo}" Width="100"/>
                            <DataGridTextColumn Header="Cédula" Binding="{Binding EstudianteCedula}" Width="90"/>
                            <DataGridTextColumn Header="Estudiante" Binding="{Binding NombreEstudiante}" Width="*"/>
                            <DataGridTextColumn Header="Curso y Horario" Binding="{Binding CursoHorario}" Width="180"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding Total, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Mon." Binding="{Binding MonedaCodigo}" Width="50"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="75"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="90"/>

                            <DataGridTemplateColumn Header="Acciones" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Botones... -->
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>