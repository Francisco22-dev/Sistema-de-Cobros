<Window x:Class="Sistema_de_Cobros_2._0.FlujoCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flujo de Caja y Egresos" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y TARJETAS SUPERIORES -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Balance Financiero Global" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Mostrar saldos en:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbMonedaDashboard" Width="100" Padding="5" SelectionChanged="CmbMonedaDashboard_SelectionChanged">
                        <ComboBoxItem Content="BS" IsSelected="True"/>
                        <ComboBoxItem Content="BCV"/>
                        <ComboBoxItem Content="EUR"/>
                        <ComboBoxItem Content="USDT"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Ingresos Históricos Totales" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtIngresos" Text="0.00 BS" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Egresos Históricos Totales" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtEgresos" Text="0.00 BS" FontSize="22" FontWeight="Bold" Foreground="#F44336" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2196F3" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SALDO NETO EN CAJA" Foreground="White" Opacity="0.9" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtSaldoNeto" Text="0.00 BS" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- PANEL INFERIOR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Registrar Gasto (Egreso)" FontSize="18" FontWeight="Bold" Foreground="#F44336" Margin="0,0,0,15"/>

                    <TextBlock Text="Categoría" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                    <ComboBox x:Name="cmbCategoria" IsEditable="True" Padding="8" FontSize="14" BorderBrush="#ccc" Margin="0,2,0,10"/>
                    <TextBlock Text="* Puede escribir una nueva si no está en la lista." FontSize="10" Foreground="#999" Margin="0,-5,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Monto a extraer" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                            <TextBox x:Name="txtMonto" Padding="8" FontSize="14" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Moneda" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                            <ComboBox x:Name="cmbMoneda" Padding="8" FontSize="14" BorderBrush="#ccc" Margin="0,2,0,0" Width="80">
                                <ComboBoxItem Content="BS" IsSelected="True"/>
                                <ComboBoxItem Content="BCV"/>
                                <ComboBoxItem Content="EUR"/>
                                <ComboBoxItem Content="USDT"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Motivo / Detalle del Gasto" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                    <TextBox x:Name="txtConcepto" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="8" FontSize="14" BorderBrush="#ccc" BorderThickness="1" Margin="0,2,0,20"/>

                    <Button IsDefault="True" Content="Registrar Gasto" Background="#F44336" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="15,12" Cursor="Hand" Click="BtnRegistrarEgreso_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- TABLA DE HISTORIAL -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Historial Completo de Egresos" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgEgresos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9FAFB" BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- COLUMNA FECHA AÑADIDA -->
                            <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaMovimiento, StringFormat=dd/MM/yyyy hh:mm tt}" Width="130"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="110"/>
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Mon." Binding="{Binding MonedaCodigo}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>