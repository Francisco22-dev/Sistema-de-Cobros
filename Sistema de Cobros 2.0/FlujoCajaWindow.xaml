<Window x:Class="Sistema_de_Cobros_2._0.FlujoCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flujo de Caja y Egresos" Height="680" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y TARJETAS SUPERIORES -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título y Selector de Moneda -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Balance Financiero Global" FontSize="20" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mostrar saldos en:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbMonedaDashboard" Width="120" Padding="6" FontSize="13" SelectionChanged="CmbMonedaDashboard_SelectionChanged">
                        <ComboBoxItem Content="BS" IsSelected="True"/>
                        <ComboBoxItem Content="$ (Dólares)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 3 Tarjetas de Resumen -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: Ingresos -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Ingresos Históricos Totales" Foreground="#666" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="txtIngresos" Text="0.00 BS" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Egresos -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Egresos Históricos Totales" Foreground="#666" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="txtEgresos" Text="0.00 BS" FontSize="22" FontWeight="Bold" Foreground="#F44336" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Saldo Neto Líquido -->
                <Border Grid.Column="2" Background="#2196F3" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.18" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SALDO NETO EN CAJA" Foreground="White" Opacity="0.9" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="txtSaldoNeto" Text="0.00 BS" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>

                        <!-- Desglose Físico y Banco -->
                        <TextBlock x:Name="txtDesglose" Text="Efectivo: 0.00 Bs | Banco: 0.00 Bs&#x0a;Divisas: 0.00 $ | Zelle: 0.00 $" 
                                   Foreground="White" FontSize="12" Opacity="0.95" Margin="0,6,0,0" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- PANEL INFERIOR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO DE EGRESOS (IZQUIERDA) -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="1"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Registrar Gasto (Egreso)" FontSize="17" FontWeight="Bold" Foreground="#F44336" Margin="0,0,0,12"/>

                        <TextBlock Text="Método de Salida" FontSize="11" FontWeight="SemiBold" Foreground="#666"/>
                        <ComboBox x:Name="cmbMetodoEgreso" Padding="6" FontSize="13" BorderBrush="#ccc" Margin="0,2,0,8">
                            <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                            <ComboBoxItem Content="Pago Móvil"/>
                            <ComboBoxItem Content="Transferencia"/>
                            <ComboBoxItem Content="Divisas (Físico)"/>
                            <ComboBoxItem Content="Zelle"/>
                        </ComboBox>

                        <TextBlock Text="Categoría" FontSize="11" FontWeight="SemiBold" Foreground="#666"/>
                        <ComboBox x:Name="cmbCategoria" IsEditable="True" Padding="6" FontSize="13" BorderBrush="#ccc" Margin="0,2,0,8"/>
                        <TextBlock Text="* Puede escribir una nueva si no está en la lista." FontSize="10" Foreground="#888" Margin="0,-4,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Monto a extraer" FontSize="11" FontWeight="SemiBold" Foreground="#666"/>
                                <TextBox x:Name="txtMonto" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Moneda" FontSize="11" FontWeight="SemiBold" Foreground="#666"/>
                                <ComboBox x:Name="cmbMoneda" Padding="6" FontSize="13" BorderBrush="#ccc" Margin="0,2,0,0" Width="80">
                                    <ComboBoxItem Content="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="BCV"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motivo / Detalle del Gasto" FontSize="11" FontWeight="SemiBold" Foreground="#666"/>
                        <TextBox x:Name="txtConcepto" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Style="{StaticResource ModernTextBox}" Margin="0,2,0,15"/>

                        <Button Content="Registrar Gasto" Style="{StaticResource BotonRedondeado}" Background="#F44336" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="0,0,0,8" Click="BtnRegistrarEgreso_Click"/>
                        <Button Content="Operaciones / Vueltos" Style="{StaticResource BotonRedondeado}" Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="12,10" Click="BtnOperaciones_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- TABLA DE HISTORIAL CON BUSCADOR (DERECHA) -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR DE EGRESOS (IDÉNTICO AL DE PAGOS) -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Historial Completo de Egresos" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtBuscarEgreso" Width="180" Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,6,0" KeyDown="TxtBuscarEgreso_KeyDown"/>
                            <Button Content="Buscar" Style="{StaticResource BotonRedondeado}" Background="#2196F3" 
                                    Foreground="White" FontWeight="Bold" Padding="12,6" Click="BtnBuscarEgreso_Click"/>
                            <Button Content="✕" Style="{StaticResource BotonRedondeado}" Background="#E5E7EB" 
                                    Foreground="#555" FontWeight="Bold" Padding="8,6" Margin="4,0,0,0" 
                                    ToolTip="Limpiar búsqueda" Click="BtnLimpiarBuscarEgreso_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Egresos -->
                    <DataGrid x:Name="dgEgresos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              HeadersVisibility="Column" Background="Transparent" RowBackground="White" 
                              AlternatingRowBackground="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaMovimiento, StringFormat=dd/MM/yyyy hh:mm tt}" Width="140"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="110"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=N2}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mon." Binding="{Binding MonedaCodigo}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>