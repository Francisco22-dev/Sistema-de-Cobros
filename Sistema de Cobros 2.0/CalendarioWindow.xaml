<Window x:Class="Sistema_de_Cobros_2._0.CalendarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Calendario" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Calendario de Clases" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Seleccione un horario. Si marca una clase como Nula, no se le cobrará a los estudiantes." Foreground="#666"/>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbGrupos" DisplayMemberPath="Display" SelectedValuePath="Id" Padding="8" SelectionChanged="CmbGrupos_SelectionChanged"/>
                    <Button Grid.Column="1" Content="Generar Clases" Background="#2196F3" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="BtnGenerar_Click"/>
                </Grid>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="dgCalendario" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha de Clase" Binding="{Binding FechaClase, StringFormat=dd/MM/yyyy}" Width="150"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>

                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Vieron Clases" Background="#4CAF50" Foreground="White" Padding="8,4" BorderThickness="0" Margin="0,0,5,0" Click="BtnRealizada_Click"/>
                                    <Button Content="Faltó Profesor (NULA)" Background="#F44336" Foreground="White" Padding="8,4" BorderThickness="0" Click="BtnNula_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>