<Window x:Class="Sistema_de_Cobros_2._0.CalendarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Calendario" Height="640" Width="800"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO Y FILTROS -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Calendario y Avance de Clases" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="El sistema calcula automáticamente la semana en curso según la fecha actual." Foreground="#666" Margin="0,2,0,12"/>

                    <!-- FILA DE SELECCIÓN -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="1. Carrera o Curso" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbCursos" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                                      SelectionChanged="CmbCursos_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="2. Filtrar horario por día / código / cohorte" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBuscarHorario" Style="{StaticResource ModernTextBox}"
                                     TextChanged="TxtBuscarHorario_TextChanged" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="3. Horario / Grupo" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbGrupos" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      IsEnabled="False"
                                      SelectionChanged="CmbGrupos_SelectionChanged"/>
                        </StackPanel>

                        <Button x:Name="btnGenerar" Grid.Column="1" Content="Generar Clases" 
                                Style="{StaticResource BotonRedondeado}" Background="#2196F3" 
                                Foreground="White" FontWeight="Bold" Padding="15,8" 
                                IsEnabled="False" VerticalAlignment="Bottom" Click="BtnGenerar_Click"/>
                    </Grid>

                    <!-- TARJETA DE PROGRESO AUTOMÁTICO (SOLO PARA VER) -->
                    <Border x:Name="bdrProgreso" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtIndicadorSemana" Text="📍 Progreso: Seleccione un horario para ver el avance automático..." 
                                       FontWeight="Bold" Foreground="#1E40AF" FontSize="13"/>
                            <TextBlock x:Name="txtDetalleProgreso" Text="Las clases anteriores a hoy se consideran vistas automáticamente sin necesidad de marcarlas." 
                                       Foreground="#3B82F6" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TABLA DE CLASES PROGRAMADAS -->
                <DataGrid Grid.Row="1" x:Name="dgCalendario" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="1" 
                          BorderBrush="#E5E7EB" RowBackground="White" AlternatingRowBackground="#F9FAFB">
                    <DataGrid.Columns>
                        <!-- NÚMERO DE CLASE -->
                        <DataGridTextColumn Header="Nº Clase" Binding="{Binding Observaciones}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- FECHA -->
                        <DataGridTextColumn Header="Fecha de Clase" Binding="{Binding FechaClase, StringFormat=dd/MM/yyyy}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ESTADO AUTOMÁTICO CON COLOR -->
                        <DataGridTextColumn Header="Estado Actual" Binding="{Binding EstadoVisual}" Width="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{Binding ColorEstadoVisual}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ACCIÓN DE EXCEPCIÓN: SOLO SI FALTÓ PROFESOR -->
                        <DataGridTemplateColumn Header="Excepciones" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Faltó Profesor (NULA)" Background="#EF4444" Foreground="White" 
                                                Padding="10,4" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"
                                                Click="BtnNula_Click" ToolTip="Anula esta fecha y agrega una semana de reposición al final"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>