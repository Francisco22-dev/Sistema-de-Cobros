<Window x:Class="Sistema_de_Cobros_2._0.CalendarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Calendario" Height="620" Width="750"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">

    <Window.Resources>
        <!-- Estilo para ComboBox moderno -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Estilo para TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botones Redondeados -->
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PANEL SUPERIOR: FILTROS Y CONTROLES -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Calendario de Clases" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="Seleccione el curso y luego el horario deseado para gestionar las asistencias." Foreground="#666" Margin="0,2,0,15"/>

                    <!-- FILA 1: CURSO Y BUSCADOR DE HORARIO -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Desplegable de Curso -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="1. Seleccione el Curso" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbCursos" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                                      SelectionChanged="CmbCursos_SelectionChanged"/>
                        </StackPanel>

                        <!-- Buscador de Texto (Opción B) -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="2. Filtrar horario por día / hora / código" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBuscarHorario" Style="{StaticResource ModernTextBox}"
                                     TextChanged="TxtBuscarHorario_TextChanged" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- FILA 2: HORARIO FILTRADO Y BOTÓN GENERAR -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Desplegable con los Horarios del Curso -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="3. Horario / Grupo" FontSize="11" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbGrupos" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                      IsEnabled="False"
                                      SelectionChanged="CmbGrupos_SelectionChanged"/>
                        </StackPanel>

                        <!-- Botón Generar Clases -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button x:Name="btnGenerar" Content="Generar Clases" 
                                    Style="{StaticResource BotonRedondeado}"
                                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                                    Padding="15,9" IsEnabled="False"
                                    Click="BtnGenerar_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- AVISO VISUAL SI EL CURSO NO TIENE HORARIOS -->
                    <TextBlock x:Name="txtAvisoSinHorarios" 
                               Text="⚠ No hay horarios asignados a este curso." 
                               Foreground="#D32F2F" FontWeight="SemiBold" FontSize="12" 
                               Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- GRILLA DE CLASES PROGRAMADAS -->
                <DataGrid Grid.Row="1" x:Name="dgCalendario" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="1" 
                          BorderBrush="#E5E7EB" RowBackground="White" AlternatingRowBackground="#F9FAFB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha de Clase" Binding="{Binding FechaClase, StringFormat=dd/MM/yyyy}" Width="150"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Acciones" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Vieron Clases" Background="#4CAF50" Foreground="White" 
                                                Padding="10,4" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"
                                                Click="BtnRealizada_Click"/>
                                        <Button Content="Faltó Profesor (NULA)" Background="#F44336" Foreground="White" 
                                                Padding="10,4" BorderThickness="0" Cursor="Hand"
                                                Click="BtnNula_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>