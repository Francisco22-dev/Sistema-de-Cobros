<Window x:Class="Sistema_de_Cobros_2._0.GestionUsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="550" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorPrimario" Color="#2196F3"/>
        <SolidColorBrush x:Key="ColorPrimarioOscuro" Color="#1976D2"/>
        <SolidColorBrush x:Key="ColorExito" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ColorPeligro" Color="#F44336"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#333333"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#666666"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de Usuarios -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15"
                BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                Margin="0,0,15,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Usuarios del Sistema"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource ColorTexto}"
                           Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="dgUsuarios"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="White"
                          AlternatingRowBackground="#F9F9F9"
                          SelectionChanged="DgUsuarios_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="100"/>
                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="80"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Activo}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Panel de Edición/Creación -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20"
                BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="txtTituloFormulario" Text="Nuevo Usuario"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource ColorTexto}"
                           Margin="0,0,0,15"/>

                <!-- Username -->
                <TextBlock Text="Nombre de usuario" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsername" Padding="10,8" FontSize="13"
                         BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                         Margin="0,0,0,12"/>

                <!-- Nombre Completo -->
                <TextBlock Text="Nombre completo" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNombreCompleto" Padding="10,8" FontSize="13"
                         BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                         Margin="0,0,0,12"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtPassword" Padding="10,8" FontSize="13"
                             BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                             Margin="0,0,0,12"/>

                <!-- Rol -->
                <TextBlock Text="Rol" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTexto}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbRol" Padding="10,8" FontSize="13"
                          BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="Usuario" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <!-- Botones -->
                <Button x:Name="btnGuardar" Content="Guardar"
                        Background="{StaticResource ColorPrimario}"
                        Foreground="White" Padding="10,8" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"
                        Click="BtnGuardar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnDesactivar" Content="Desactivar"
                        Background="{StaticResource ColorPeligro}"
                        Foreground="White" Padding="10,8" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"
                        Click="BtnDesactivar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnEliminar" Content="Eliminar"
                        Background="Transparent"
                        Foreground="{StaticResource ColorPeligro}"
                        Padding="10,8" FontSize="13" FontWeight="SemiBold"
                        BorderBrush="{StaticResource ColorPeligro}" BorderThickness="1"
                        Cursor="Hand" Margin="0,0,0,8"
                        Click="BtnEliminar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnCancelar" Content="Cancelar"
                        Background="Transparent"
                        Foreground="{StaticResource ColorTextoSecundario}"
                        Padding="10,8" FontSize="13"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnCancelar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
