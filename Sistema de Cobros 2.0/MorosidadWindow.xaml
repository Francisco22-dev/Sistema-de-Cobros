<Window x:Class="Sistema_de_Cobros_2._0.MorosidadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Morosos" Height="550" Width="850"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Cuentas por Cobrar" FontSize="22" FontWeight="Bold" Foreground="#D32F2F"/>
                <TextBlock Text="Estudiantes que tienen deuda pendiente según las clases que ya han transcurrido." Foreground="#666"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="dgMorosos" AutoGenerateColumns="False" IsReadOnly="True" RowBackground="#FFEBEE" AlternatingRowBackground="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="90"/>
                    <DataGridTextColumn Header="Estudiante" Binding="{Binding NombreCompleto}" Width="*"/>
                    <DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="150"/>
                    <DataGridTextColumn Header="Clases Vistas" Binding="{Binding ClasesImpartidas}" Width="90"/>

                    <DataGridTextColumn Header="DEUDA" Binding="{Binding DeudaStr}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#D32F2F"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="WhatsApp" Background="#4CAF50" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand" Click="BtnWhatsApp_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>