<Window x:Class="Sistema_de_Cobros_2._0.MorosidadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Morosos" Height="550" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5">
    <Grid>
    <Border Background="White" CornerRadius="8" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <!-- ENCABEZADO Y BUSCADOR UNIFICADO -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Cuentas por Cobrar" FontSize="22" FontWeight="Bold" Foreground="#D32F2F"/>
                    <TextBlock Text="Estudiantes con clases vencidas. (Amarillo: 1-3 clases | Rojo: 4+ clases)" Foreground="#666" Margin="0,0,0,10"/>

                    <!-- UN SOLO BUSCADOR POTENTE -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#333"/>
                        <TextBox x:Name="txtBuscar" Width="360" Padding="8,6" FontSize="13" 
                 BorderBrush="#ccc" BorderThickness="1" TextChanged="TxtBuscar_TextChanged"/>
                        <TextBlock Text="(Busca por Cédula, Nombre, Curso o Código ej: AAD2610, ASE, 31395050)" 
                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#777"/>
                    </StackPanel>
                </StackPanel>

                <!-- TABLA DE MOROSOS -->
            <!-- Importante: Sin RowBackground para que el ColorFila funcione -->
            <DataGrid Grid.Row="1" x:Name="dgMorosos" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1">

                <!-- ESTILO DINÁMICO DE COLOR (Amarillo o Rojo) -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding ColorFila}"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="90"/>
                    <DataGridTextColumn Header="Estudiante" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Curso y Grupo" Binding="{Binding Curso}" Width="250"/>
                        <DataGridTextColumn Header="Clases Vistas" Binding="{Binding ClasesImpartidas}" Width="90"/>

                    <!-- COLUMNA DE ABONOS PREVIOS -->
                    <DataGridTextColumn Header="Abonado ($)" Binding="{Binding TotalPagado, StringFormat=N2}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- COLUMNA DE DEUDA (En Dólares y Bs) -->
                    <DataGridTextColumn Header="DEUDA AL DÍA" Binding="{Binding DeudaStr}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#D32F2F"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- COLUMNA DE WHATSAPP -->
                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="WhatsApp" Background="#4CAF50" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand" Click="BtnWhatsApp_Click">
                                    <!-- ESTILO DINÁMICO DE VISIBILIDAD -->
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostrarWhatsApp}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
    </Grid>
</Window>