<Window x:Class="Sistema_de_Cobros_2._0.CargandoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciando Sistema" Height="260" Width="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">

    <Border Background="White" CornerRadius="12" Margin="15" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO INSTITUCIONAL -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="CEVENCA" FontSize="24" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Cobros 2.0" FontSize="13" FontWeight="SemiBold" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- MENSAJES DE ESTADO DINÁMICOS -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock x:Name="txtEstado" Text="Conectando con el servidor local..." 
                           FontSize="13" FontWeight="SemiBold" Foreground="#333333" 
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="txtDetalle" Text="Por favor espere un momento..." 
                           FontSize="11" Foreground="#888888" 
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- BARRA DE PROGRESO MODERNA -->
            <Grid Grid.Row="2" Margin="0,5,0,15">
                <ProgressBar x:Name="pbCarga" Height="6" Minimum="0" Maximum="100" Value="10" 
                             BorderThickness="0" Background="#E5E7EB" Foreground="#2196F3">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" 
                                            CornerRadius="3" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>

            <!-- PIE DE VENTANA -->
            <TextBlock Grid.Row="3" Text="Red local segura • Base de datos centralizada" 
                       FontSize="10" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>